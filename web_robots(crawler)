#项目：网络机器人(爬虫)，获取豆瓣top250的电影信息（包含：电影名，年份，上映时间，类型，时长，评分，语言，导演，编剧，主演）

import requests
from lxml import html
import csv

douban_url="https://movie.douban.com"
douban_top250_url="https://movie.douban.com/top250"

all_movies=[]

#获取豆瓣top250的2-10页的网址
def get_douban_top250_url(page):
    return f"https://movie.douban.com/top250?start={25*(page-1)}&filter="

#电影年份信息正则化
def get_moivie_year(movie_year):
    year = movie_year.strip() if movie_year else ''
    return year.replace('(','').replace(')','')

#获取电影详细信息
def get_movie_info(movie_full_url):
    movie_response=requests.get(movie_full_url)
    movie_doc=html.fromstring(movie_response)

    movie_name=movie_doc.xpath('//*[@id="content"]/h1/span[@property="v:itemreviewed"]/text()')
    movie_year=movie_doc.xpath('//*[@id="content"]/h1/span[@class="year"]/text()')
    movie_date=movie_doc.xpath('//*[@id="info"]/span[@property="v:initialReleaseDate"]/text()')
    movie_type=movie_doc.xpath('//*[@id="info"]/span[@property="v:genre"]/text()')
    movie_times=movie_doc.xpath('//*[@id="info"]/span[@property="v:runtime"]/text()')
    movie_score=movie_doc.xpath('//*[@id="interest_sectl"]/div[1]/div[2]/strong/text()')
    movie_language=movie_doc.xpath('//*[@id="info"]/text()[3]')
    movie_director=movie_doc.xpath('//*[@id="info"]/span[1]/span[2]/a/text()')
    movie_author=movie_doc.xpath('//*[@id="info"]/span[2]/span[2]/a/text()')
    movie_actor=movie_doc.xpath('//*[@id="info"]/span[3]/span[2]/span/a/text()')

    movie_info={'电影名':movie_name.strip() if movie_name else '',
                '年份':get_moivie_year(movie_year),
                '上映时间':','.join(movie_date) if movie_date else '',
                '类型':','.join(movie_type) if movie_type else '',
                '时长':movie_times.strip() if movie_times else '',
                '评分':movie_score.strip() if movie_score else '',
                '语言':movie_language.strip() if movie_language else '',
                '导演':','.join(movie_director) if movie_director else '',
                '编剧':','.join(movie_author) if movie_author else '',
                '主演':','.join(movie_actor) if movie_actor else ''}
    return movie_info

#保存所有电影信息
def save_all_movies(all_movies):
    with open('douban_top250.csv','w',newline='') as f:
        writer = csv.DictWriter(f,fieldnames=all_movies[0].keys())
        writer.writeheader()
        writer.writerows(all_movies)

#主函数
def main():
    """
    :return:豆瓣电影top250电影详细信息
    """
    for page in range(1,11):
        # 1.发送请求查看top250电影名单
        if page==1:
            response = requests.get(douban_top250_url,timeout=60)
        else:
            douban_top250_url_2_10=get_douban_top250_url(page)
            response = requests.get(douban_top250_url_2_10,timeout=60)
        # 2.解析获取具体电影地址
        doc = html.fromstring(response.text)
        movie_list = doc.xpath('//*[@id="content"]/div/div[1]/ol/li')
        # 3.获取电影详细信息
        for movie in movie_list:
            movie_url = movie.xpath('./div/div/a/@href')
            if movie_url:
                movie_full_url = douban_url+movie_url[0]
                print(movie_full_url)
                movie_info = get_movie_info(movie_full_url)
                all_movies.append(movie_info)
        # 4.保存至csv文件
        save_all_movies(all_movies)


if __name__=="__main__":
    main()
